{
  "name": "ae-bvalue-backend",
  "version": "1.0.0",
  "description": "Real-time acoustic-emission b-value monitoring backend (unaxial loading experiments)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/http/server.js",
    "dev": "tsx watch src/http/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "MONGO_TEST_URL=${MONGO_TEST_URL:-mongodb://127.0.0.1:27017} vitest run tests/mongo.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
